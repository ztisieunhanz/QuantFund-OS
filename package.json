{
  "name": "quantfund-os",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:server": "tsc -p tsconfig.server.json --noEmit && vite build --ssr server/productionServer.ts --outDir dist-server",
    "perf:check": "node scripts/check-performance-budget.mjs",
    "perf:test": "node --test scripts/check-performance-budget.selftest.mjs",
    "preview": "vite preview",
    "smoke:production": "node scripts/production-smoke.mjs",
    "start": "node dist-server/productionServer.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "lightweight-charts": "^5.0.8",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^2.15.4",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^26.5.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.9.2",
    "vite": "^7.1.5",
    "vitest": "^5.0.1"
  }
}
